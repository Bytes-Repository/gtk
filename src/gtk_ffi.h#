;; ── GTK4 — GtkAlertDialog (GTK >= 4.10) ───────────────────────────────────────
;; Prawdziwy konstruktor (`gtk_alert_dialog_new`) jest wariadyczny (C-owe
;; `...`); wolamy go z zerem argumentow wariadycznych — czyli dokladnie
;; jak `printf(msg)` bez %-argumentow — zeby nie polegac na jeszcze
;; niepewnym (patrz codegen.rs) wsparciu H# dla przekazywania realnych
;; argumentow wariadycznych przez `extern`. Zeby bylo to bezpieczne mimo
;; ze `msg` trafia jako C-owy format string, `gtk.h#` najpierw ucieka
;; kazdy `%` na `%%` (`strings::replace_all`) zanim tu trafi.
;; `gtk_alert_dialog_show` jest w pelni "fire-and-forget" (nie zwraca
;; wyboru uzytkownika — to wymagaloby async `GAsyncReadyCallback`, a wiec
;; C-owego wskaznika funkcji, poza zakresem biblioteki w 100% H#).

extern static [c, "gtk4"] is
    fn gtk_alert_dialog_new(escaped_format: string) -> int
    fn gtk_alert_dialog_set_modal(dialog: int, modal: int)
    fn gtk_alert_dialog_set_detail(dialog: int, detail: string)
    fn gtk_alert_dialog_show(dialog: int, parent: int)
end

